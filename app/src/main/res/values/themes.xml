<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GraniteFlow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryVariant">@color/primary_navy_dark</item>
        <item name="colorOnPrimary">@color/text_on_pill</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/top_bar_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:windowAnimationStyle">@style/SmoothWindowAnimations</item>
    </style>

    <style name="SmoothWindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Launch splash: GraniteFlow logo on brand navy -->
    <style name="Theme.GraniteFlow.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_logo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.GraniteFlow</item>
        <item name="android:statusBarColor">@color/brand_logo_bg</item>
        <item name="android:navigationBarColor">@color/brand_logo_bg</item>
    </style>
</resources>
