<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- Top Header (Matching ExportPage.tsx) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_surface"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnExportBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/shape_circular_button"
                android:contentDescription="Back"
                android:src="?attr/homeAsUpIndicator"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="EXPORT"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExportEditDoc"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="✎ Edit"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/card_border" />

            <Button
                android:id="@+id/btnExportPrintPdf"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="@color/brand_blue"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="🖨️ Print / PDF"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- 5 Document Tabs Row (Exact match to ExportPage.tsx) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabDocInspectionReport"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_type_pill_active"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="INSPECTION REPORT"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabDocGrossPacking"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_type_pill_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="G. PACKING LIST"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabDocNetPacking"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_type_pill_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="N. PACKING LIST"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabDocGrossInvoice"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_type_pill_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="G. INVOICE"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabDocNetInvoice"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/shape_type_pill_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="N. INVOICE"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Scrollable Document Sheet Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- A4 Paper Preview Sheet Card -->
            <LinearLayout
                android:id="@+id/llDocumentSheetContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_card_modern"
                android:orientation="vertical"
                android:padding="16dp" />

            <!-- Bottom Quick Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBottomEditBlocks"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="✎ Edit Blocks"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_blue"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/brand_blue" />

                <Button
                    android:id="@+id/btnBottomExportPdf"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="@color/brand_blue"
                    android:text="📄 Generate &amp; Share A4 PDF"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
