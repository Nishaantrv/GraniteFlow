<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_navy"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/doc_white"
            app:title="Block Details"
            app:titleTextColor="@color/doc_white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Reference Image 3 Block Measurement Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/table_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title Header -->
                    <TextView
                        android:id="@+id/tvBlockTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="BLOCK NO : 301"
                        android:textColor="@color/doc_black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/table_border" />

                    <!-- Measurement Table Grid -->
                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <!-- Header Row -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp">

                            <TextView
                                android:text="MEASUREMENT"
                                android:textColor="@color/allowance_blue"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:text="LENGTH (CM)"
                                android:textColor="@color/allowance_blue"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:text="HEIGHT (CM)"
                                android:textColor="@color/allowance_blue"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:text="WIDTH (CM)"
                                android:textColor="@color/allowance_blue"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:text="ALLOWANCE"
                                android:textColor="@color/allowance_blue"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:text="NET CBM"
                                android:textColor="@color/allowance_blue"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </TableRow>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/table_border" />

                        <!-- GROSS Row -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/gross_row_bg"
                            android:paddingVertical="10dp">

                            <TextView
                                android:text="GROSS"
                                android:textColor="@color/doc_black"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvGrossL"
                                android:text="280"
                                android:textColor="@color/doc_black"
                                android:textSize="11sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvGrossH"
                                android:text="185"
                                android:textColor="@color/doc_black"
                                android:textSize="11sp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvGrossW"
                                android:text="185"
                                android:textColor="@color/doc_black"
                                android:textSize="11sp"
                                android:gravity="center" />

                            <!-- Merged allowance label in NET row -->
                            <TextView
                                android:id="@+id/tvAllowanceMerged"
                                android:text="10 CM"
                                android:textColor="@color/allowance_blue"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvGrossCbm"
                                android:text="9.583"
                                android:textColor="@color/doc_black"
                                android:textSize="11sp"
                                android:gravity="center" />
                        </TableRow>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/table_border" />

                        <!-- NET Row (Pale Green) -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/net_row_bg"
                            android:paddingVertical="10dp">

                            <TextView
                                android:text="NET"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvNetL"
                                android:text="270"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvNetH"
                                android:text="175"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvNetW"
                                android:text="175"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:text="10 CM"
                                android:textColor="@color/allowance_blue"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvNetCbmValue"
                                android:text="8.269"
                                android:textColor="@color/net_cbm_green"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Diagrams Box (VIEW A & VIEW B matching Image 3) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/table_border"
                app:strokeWidth="1.5dp">

                <com.graniteflow.app.ui.inspection.BlockDiagramView
                    android:id="@+id/diagramView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@color/doc_white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: REMARKS box matching Image 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/table_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/doc_black"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="REMARKS"
                        android:textColor="@color/doc_white"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:text="-"
                        android:textColor="@color/doc_black"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Attached Photos Gallery Section (Image 4) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ATTACHED QUARRY PHOTOS"
                android:textColor="@color/primary_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/primary_navy"
                android:text="Add Block Photo (Camera / Gallery)"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/accent_blue"
                android:text="Save Block Changes"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar Matching Image 3 and 4 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/nav_bar_bg"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
