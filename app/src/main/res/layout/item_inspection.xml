<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Left Icon Container -->
        <TextView
            android:id="@+id/ivInspectionCubeIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/shape_badge_blue"
            android:gravity="center"
            android:text="🧊"
            android:textSize="20sp" />

        <!-- Right Actions: Duplicate + Chevron -->
        <LinearLayout
            android:id="@+id/layoutRightActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDuplicateInspection"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/shape_circular_button"
                android:gravity="center"
                android:text="📋"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Duplicate Session" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/text_secondary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Middle Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivInspectionCubeIcon"
            android:layout_toStartOf="@id/layoutRightActions"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvInspectionId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XOW/XMN"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvInspectionDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Volume + Blocks count -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTotalNetCbm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15.00 m³"
                    android:textColor="@color/brand_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBlockCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" (2 blks)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
