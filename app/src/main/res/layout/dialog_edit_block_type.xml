<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_card_modern"
    android:padding="20dp">

    <!-- Header badge & title -->
    <TextView
        android:id="@+id/tvModalBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EDIT TYPE PRESET"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/brand_blue"
        android:background="@drawable/shape_badge_blue"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvModalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configure Type T1"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update allowance, starting number and pricing. Changes retroactively recalculate all blocks of this type."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Type Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TYPE NAME (E.G. T1, FRESH, LOT)"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.06"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTypeName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/shape_search_bubble"
        android:paddingHorizontal="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:singleLine="true"
        android:layout_marginBottom="14dp" />

    <!-- Allowance (cm) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ALLOWANCE (CM)"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.06"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTypeAllowance"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/shape_search_bubble"
        android:paddingHorizontal="16dp"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/brand_blue"
        android:singleLine="true"
        android:layout_marginBottom="14dp" />

    <!-- Starting Block Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STARTING BLOCK NUMBER"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.06"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTypeStartingNumber"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/shape_search_bubble"
        android:paddingHorizontal="16dp"
        android:inputType="number"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:singleLine="true"
        android:layout_marginBottom="14dp" />

    <!-- Price / CBM -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRICE PER CBM (USD)"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.06"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTypePrice"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/shape_search_bubble"
        android:paddingHorizontal="16dp"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:singleLine="true"
        android:layout_marginBottom="20dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelEditType"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="CANCEL"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveEditType"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="APPLY PRESET"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_blue"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
