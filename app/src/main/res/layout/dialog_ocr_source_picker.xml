<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_card_modern"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan Quarry Slip"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Extract block dimensions and calculate Net CBM instantly."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Source Option 1: Camera -->
    <LinearLayout
        android:id="@+id/btnPickerCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/shape_quick_action_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_camera"
            android:contentDescription="Camera"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Take Photo"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Capture paper slip directly"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="Next"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <!-- Source Option 2: Gallery -->
    <LinearLayout
        android:id="@+id/btnPickerGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/shape_quick_action_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_download"
            android:contentDescription="Gallery"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose from Gallery"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select saved photo from device"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="Next"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <!-- Instant Demo Pill (Fix height & wrap content so no text is ever clipped) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickerDemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/shape_pill_button_secondary"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:text="⚡ Test with Sample Slip (1-Tap Demo)"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/pill_inactive_bg"
        app:cornerRadius="23dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp" />

    <!-- Cancel Button -->
    <TextView
        android:id="@+id/btnPickerCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
