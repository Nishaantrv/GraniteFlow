<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_navy"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/doc_white"
            app:title="Inspection Report"
            app:titleTextColor="@color/doc_white"
            app:subtitleTextColor="#94A3B8" />
    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Multi-page ViewPager2 with smooth animation -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerPdf"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/layoutBottomActions"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <!-- Floating Top Page Pill: Page X of Y -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#CC0F172A"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvPageIndicatorPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Page 1 of 1"
                android:textColor="@color/doc_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating Navigation Arrow: Previous -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnPrevPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:contentDescription="Previous Page"
            app:fabCustomSize="42dp"
            app:backgroundTint="#CC0F172A"
            app:tint="@color/doc_white"
            app:srcCompat="@drawable/ic_arrow_back"
            app:elevation="4dp"
            app:borderWidth="1dp"
            app:rippleColor="#33FFFFFF" />

        <!-- Floating Navigation Arrow: Next -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnNextPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Next Page"
            app:fabCustomSize="42dp"
            app:backgroundTint="#CC0F172A"
            app:tint="@color/doc_white"
            app:srcCompat="@drawable/ic_arrow_forward"
            app:elevation="4dp"
            app:borderWidth="1dp"
            app:rippleColor="#33FFFFFF" />

        <!-- Fallback Empty Placeholder if PDF cannot be rendered -->
        <LinearLayout
            android:id="@+id/layoutPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/layoutBottomActions"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_picture_as_pdf"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvDocFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="INSPECTION_REPORT.pdf"
                android:textColor="@color/doc_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Multi-page Inspection Certificate"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:id="@+id/layoutBottomActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#1E293B"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSharePdf"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/primary_navy"
                android:text="Share PDF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveToDownloads"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Save PDF"
                android:textColor="@color/doc_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_download"
                app:iconGravity="textStart"
                app:iconTint="@color/doc_white"
                app:strokeColor="#475569"
                app:strokeWidth="1.2dp" />
        </LinearLayout>

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
