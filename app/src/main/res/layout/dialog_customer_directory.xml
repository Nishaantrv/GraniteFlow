<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_card_modern"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Directory"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDirectorySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select, edit, or add saved export customers"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseDirectory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/shape_circular_button"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/etSearchDirectory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/shape_input_rounded"
        android:hint="🔍 Search by company name or country..."
        android:paddingHorizontal="14dp"
        android:textColor="@color/input_text"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Scrollable List of Customers -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/containerCustomerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnStartMarkingFromDirectory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/brand_blue"
        android:text="START MARKING ›"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="14dp" />

    <!-- Add New Customer Button -->
    <Button
        android:id="@+id/btnAddNewCustomerInDirectory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/brand_blue"
        android:text="+ ADD NEW CUSTOMER"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

</LinearLayout>
