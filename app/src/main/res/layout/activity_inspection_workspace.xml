<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnWorkspaceBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/shape_circular_button"
            android:contentDescription="Back"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvWorkspaceConsigneePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/shape_badge_blue"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:maxWidth="80dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="CONSIGNEE"
            android:textColor="@color/brand_blue"
            android:textSize="9sp" />

        <!-- Dynamic Type Switcher Pills (+, T1, T2, T3) -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llTypeSwitcherContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddNewType"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_circular_button"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/brand_blue"
                    android:textSize="15sp" />

                <!-- Container dynamically populated with T1, T2, T3 buttons -->
                <LinearLayout
                    android:id="@+id/llDynamicTypePills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnHeaderSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/shape_circular_button"
            android:contentDescription="Settings"
            android:src="@drawable/ic_gear"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnWorkspaceOpenList"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/shape_circular_button"
            android:contentDescription="Blocks List"
            android:src="@drawable/ic_check"
            app:tint="@color/brand_blue" />
    </LinearLayout>

    <!-- Main Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomSummaryBar"
        android:layout_below="@id/headerBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- Status Bar Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvWorkspaceSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/shape_badge_blue"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="› NEW BLOCK T1 #1"
                    android:textColor="@color/brand_blue"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvLiveNetCbmPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/shape_badge_blue"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="~0.000 m³"
                    android:textColor="@color/brand_blue"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- Sleek Clutter-Free Block Visualizer Card -->
            <LinearLayout
                android:id="@+id/cardVisualizer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/shape_card_modern"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Top Row inside Visualizer: Badge on Left, Compact Action Pills on Right -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/shape_badge_blue"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp">

                            <TextView
                                android:id="@+id/tvBlockTypeName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="T1"
                                android:textColor="@color/brand_blue"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvBlockNumberHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="#001"
                                android:textColor="@color/brand_blue"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPhotoCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/shape_badge_blue"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:text="0 PHOTOS"
                            android:textColor="@color/brand_blue"
                            android:textSize="9sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvWorkspaceEngineBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/shape_input_rounded"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:text="✨ Gemini AI"
                            android:textColor="@color/brand_blue"
                            android:textSize="9sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Compact Action Pills on Top Right -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnWorkspaceAiOcr"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/shape_badge_blue"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="9dp"
                            android:text="✨ AI Slip"
                            android:textColor="@color/brand_blue"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/btnWorkspaceGallery"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/shape_circular_button"
                            android:gravity="center"
                            android:text="🖼️"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnWorkspaceCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/shape_tab_pill_active"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="📷 Photo"
                            android:textColor="@color/white"
                            android:textSize="10sp" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Hidden Watermark Reference (kept only for ID compatibility, hidden to prevent clutter) -->
                <TextView
                    android:id="@+id/tvWatermarkBlockNo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Live 2D/3D Oblique Block Diagram (Only renders vector after dimensions are entered!) -->
                <com.graniteflow.app.ui.inspection.BlockDiagramView
                    android:id="@+id/blockDiagramVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="112dp" />
            </LinearLayout>

            <!-- 3 Sleek Proportional Dimension Inputs -->

            <!-- LENGTH INPUT -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/selector_dimension_input"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="LENGTH (CM)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etLength"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical|end"
                    android:hint="0"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:minWidth="140dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="19sp" />
            </RelativeLayout>

            <!-- HEIGHT INPUT -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/selector_dimension_input"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="HEIGHT (CM)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical|end"
                    android:hint="0"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:minWidth="140dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="19sp" />
            </RelativeLayout>

            <!-- WIDTH INPUT -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/selector_dimension_input"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="WIDTH (CM)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etWidth"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical|end"
                    android:hint="0"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:minWidth="140dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="19sp" />
            </RelativeLayout>

            <!-- REMARKS INPUT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="REMARKS"
                    android:textColor="@color/text_secondary"
                    android:textSize="9.5sp" />

                <EditText
                    android:id="@+id/etBlockRemarks"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/selector_dimension_input"
                    android:fontFamily="sans-serif"
                    android:hint="Optional notes for this block..."
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- CONDITIONAL END-TO-END MEASUREMENT SECTION -->
            <LinearLayout
                android:id="@+id/llWorkspaceEndToEndSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/shape_card_modern"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="📏 END-TO-END MEASUREMENT"
                    android:textColor="@color/brand_blue"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="E2E LENGTH"
                            android:textColor="@color/text_secondary"
                            android:textSize="8.5sp" />
                        <EditText
                            android:id="@+id/etE2ELength"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/shape_input_rounded"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:hint="0"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="E2E HEIGHT"
                            android:textColor="@color/text_secondary"
                            android:textSize="8.5sp" />
                        <EditText
                            android:id="@+id/etE2EHeight"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/shape_input_rounded"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:hint="0"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="E2E WIDTH"
                            android:textColor="@color/text_secondary"
                            android:textSize="8.5sp" />
                        <EditText
                            android:id="@+id/etE2EWidth"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/shape_input_rounded"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:hint="0"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="DEFECTS / NOTES"
                    android:textColor="@color/text_secondary"
                    android:textSize="8.5sp" />
                <EditText
                    android:id="@+id/etDefectDescription"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/shape_input_rounded"
                    android:fontFamily="sans-serif"
                    android:hint="Describe defects, inclusions..."
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action Buttons: PREV and NEXT BLOCK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnWorkspacePrevBlock"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="‹ PREV"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btnWorkspaceNextBlock"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:backgroundTint="@color/brand_blue"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:text="NEXT BLOCK ›"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- Finish Details CTA Button (Only visible when blocks > 0) -->
            <Button
                android:id="@+id/btnWorkspaceFinishDetails"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="FINISH DETAILS →"
                android:textColor="@color/brand_blue"
                android:textSize="12sp"
                android:visibility="gone"
                app:cornerRadius="22dp"
                app:strokeColor="@color/brand_blue"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Live Summary Bar -->
    <LinearLayout
        android:id="@+id/bottomSummaryBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:background="@color/card_surface"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <!-- BLOCKS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="BLOCKS"
                android:textColor="@color/text_secondary"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/tvSummaryBlocks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@color/card_border" />

        <!-- GROSS CBM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="GROSS"
                android:textColor="@color/text_secondary"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/tvSummaryGross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0.000 m³"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@color/card_border" />

        <!-- NET CBM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="NET"
                android:textColor="@color/text_secondary"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/tvSummaryNet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0.000 m³"
                android:textColor="@color/brand_blue"
                android:textSize="12.5sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@color/card_border" />

        <!-- VALUE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="VALUE"
                android:textColor="@color/text_secondary"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/tvSummaryValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0 USD"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
