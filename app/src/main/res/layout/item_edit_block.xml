<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/shape_card_modern"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left Mini Block Badge -->
        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/shape_badge_blue"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemBlockTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T1"
                android:textColor="@color/brand_blue"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemBlockNumberBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#001"
                android:textColor="@color/brand_blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Middle Title & Dimensions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemBlockTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Block #001"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemBlockDims"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="280 × 185 × 185 cm"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemBlockRemarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textStyle="italic"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right Net CBM & Allowance -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemBlockNetCbm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8.269"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NET CBM"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemBlockAllowanceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T1: 15cm"
                android:textColor="@color/brand_blue"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnItemDeleteBlock"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/shape_circular_button"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete" />
    </LinearLayout>
</LinearLayout>
